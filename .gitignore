# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
backend/node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS & OS
.DS_Store
*.pem
Thumbs.db

# local env files (Secrets Protection)
.env*.local
backend/.env
*.backup.js

# Database & User Uploads (Privacy & Data Protection)
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/uploads/*
!backend/uploads/.gitkeep
!backend/data/.gitkeep

# typescript
*.tsbuildinfo

app-example
